CREATE OR REPLACE FUNCTION {{routineName}}(
{{{params}}}
) RETURNS INT LANGUAGE plpgsql AS $$
DECLARE
  affected INT;
BEGIN
  DELETE FROM {{tableTok}} t
  WHERE t.{{pkName}} = {{routineName}}.{{pkName}} AND t.{{updatedCol}} = {{routineName}}.{{expectedUpdated}};
  GET DIAGNOSTICS affected = ROW_COUNT;
  RETURN affected;
END;
$$;
